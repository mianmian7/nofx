# Git
.git
.gitignore
.github

# Personal deploy scripts (never part of the build context)
deploy-*.sh

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Build artifacts
nofx
nofx_test
*.exe
*.dll
*.so
*.dylib

# Documentation
*.md
!README.md
docs/

# Runtime data
data/
decision_logs/
*.log

# Config files (should be mounted)
config.json

# Secrets and local state (never send these into a build context)
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/*.cert
**/*secret*.json
**/*credentials*.json
**/*.db
**/*.sqlite*

# Web build artifacts (but include source for multi-stage build)
web/node_modules/
web/dist/

# Temporary files
tmp/
temp/
*.tmp

# Local validation artifacts (never needed by backend/frontend builds)
.playwright-cli/
output/
screenshots/
.cache/
coverage/
playwright-report/
test-results/

# Private local overrides are never build inputs
/.private/
